# Example environment file — copy to .env.local and fill in each value.

# API Ninjas — earnings-call transcript lookups
API_NINJAS_KEY=

# Finnhub — market data and company fundamentals
FINNHUB_API_KEY=

# Financial Modeling Prep — analyst peers and financials
FMP_API_KEY=

# FRED (St. Louis Fed) — macroeconomic data
FRED_API_KEY=

# Google Gemini — LLM inference
GEMINI_API_KEY=

# Groq — LLM inference (gateway provider)
GROQ_API_KEY=

# Cerebras Cloud — LLM inference (gateway provider; optional failsafe)
CEREBRAS_API_KEY=

# NVIDIA NIM (build.nvidia.com) — LLM inference (gateway provider; optional failsafe)
NVIDIA_API_KEY=

# Supabase — public anon key for the browser client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — project URL
NEXT_PUBLIC_SUPABASE_URL=

# Canonical public origin of the deployed app. The web app reads THIS var
# (src/lib/site.ts + the password-recovery flow) to build recovery + canonical
# links. e.g. https://fortis-stocks.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — service-role key for server-side / pipeline use (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Tiingo — historical fundamentals, prices and news
TIINGO_API_KEY=
