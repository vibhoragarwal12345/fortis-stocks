# Example environment file — copy to .env.local and fill in each value.

# API Ninjas — earnings-call transcript lookups
API_NINJAS_KEY=

# Finnhub — market data and company fundamentals
FINNHUB_API_KEY=

# Financial Modeling Prep — analyst peers and financials
FMP_API_KEY=

# FRED (St. Louis Fed) — macroeconomic data
FRED_API_KEY=

# Google Gemini — LLM inference
GEMINI_API_KEY=

# Groq — LLM inference
GROQ_API_KEY=

# Supabase — public anon key for the browser client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — project URL
NEXT_PUBLIC_SUPABASE_URL=

# Resend — transactional email delivery
RESEND_API_KEY=

# Resend — webhook signing secret (Svix `whsec_…` from the dashboard).
# Required in production so /api/webhooks/resend rejects forged events.
RESEND_WEBHOOK_SECRET=

# Sender address shown in the brief emails. Domain must be verified in Resend.
EMAIL_FROM_ADDRESS="Fortis Briefs <briefs@example.com>"

# CAN-SPAM physical address printed in the email footer.
EMAIL_PHYSICAL_ADDRESS=

# Shared secret protecting /api/cron/send-reports. Vercel Cron sends this
# as `Authorization: Bearer <secret>`; the route also accepts `x-cron-secret`.
CRON_SECRET=

# Public origin of the deployed app. Used to build unsubscribe + report URLs
# in outgoing emails. e.g. https://app.fortis.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — service-role key for server-side / pipeline use (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Tiingo — historical fundamentals, prices and news
TIINGO_API_KEY=
