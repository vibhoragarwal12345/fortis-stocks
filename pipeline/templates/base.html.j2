<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>Fortis — {{ report.header.title }} — {{ report.header.date_label }}</title>
<style>
  /* ──────────────────────────────────────────────────────────────────
     Fortis daily brief — restrained institutional design.
     Email-safe: no external assets, no flexbox layout, conservative
     CSS subset only. Inline overrides live alongside class names where
     specific email clients (Outlook 2016+) need belt-and-braces.
     ────────────────────────────────────────────────────────────────── */

  body {
    margin: 0; padding: 0;
    background: #f4f3ee;        /* warm off-white outside the page */
    color: #1a1a1a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                  Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 15px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
  }
  .wrap {
    max-width: 720px;
    margin: 0 auto;
    background: #ffffff;
    padding: 28px 32px 40px;
    border-left: 1px solid #e7e5df;
    border-right: 1px solid #e7e5df;
  }

  /* ── Typography ──────────────────────────────────────────────────── */
  h1, h2, h3 {
    font-family: Georgia, "Times New Roman", "Source Serif Pro", serif;
    font-weight: 700;
    color: #0d0d0d;
    letter-spacing: -0.01em;
    margin: 0;
  }
  h1 { font-size: 26px; line-height: 1.15; }
  h2 {
    font-size: 18px; line-height: 1.2;
    margin-top: 36px; padding-bottom: 8px;
    border-bottom: 1px solid #d4d4d4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 13px;
    color: #2a2a2a;
    font-family: Georgia, serif;
  }
  h3 { font-size: 16px; margin-top: 16px; margin-bottom: 6px; }
  p  { margin: 8px 0 12px; }
  a  { color: #0f3a5f; text-decoration: none; border-bottom: 1px solid #cdd9e4; }

  .ticker, .ticker-md, .ticker-lg {
    font-family: ui-monospace, "SF Mono", "Cascadia Mono", Menlo,
                  Consolas, "Courier New", monospace;
    letter-spacing: 0.04em; color: #0d0d0d; font-weight: 600;
  }
  .ticker-md { font-size: 17px; }
  .ticker-lg { font-size: 22px; letter-spacing: 0.06em; }

  .muted { color: #6b6b6b; }
  .small { font-size: 12.5px; }
  .kicker {
    text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px;
    color: #6b6b6b; font-weight: 700; margin-right: 6px;
  }
  .section-kicker {
    text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px;
    color: #2a2a2a; font-weight: 700;
    margin: 18px 0 6px;
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .head {
    border-bottom: 2px solid #0d0d0d;
    padding-bottom: 14px; margin-bottom: 16px;
  }
  .head .brand {
    font-family: Georgia, serif; font-weight: 700; font-size: 14px;
    letter-spacing: 0.16em; text-transform: uppercase; color: #6b6b6b;
  }
  .head .date {
    font-style: italic; color: #6b6b6b; margin-top: 4px;
    font-family: Georgia, serif; font-size: 14px;
  }
  .grade-row {
    margin-top: 10px; font-size: 13px; color: #4a4a4a;
  }
  .grade-row .pill { margin-right: 6px; }
  .verif {
    float: right; font-size: 12.5px; color: #6b6b6b;
    font-family: ui-monospace, monospace;
  }

  /* ── Badges (conviction grade) ─────────────────────────────────── */
  .badge {
    display: inline-block; padding: 2px 8px; border-radius: 3px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; vertical-align: middle;
    border: 1px solid transparent;
  }
  .badge-a { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
  .badge-b { background: #f5f5f4; color: #44403c; border-color: #d6d3d1; }
  .badge-c { background: #fffbeb; color: #b45309; border-color: #fde68a; }
  .badge-neutral { background: #f5f5f5; color: #525252; border-color: #d4d4d4; }

  /* ── Severity pills (portfolio alerts) ─────────────────────────── */
  .pill {
    display: inline-block; padding: 1px 7px; border-radius: 2px;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .pill-critical { background: #fef2f2; color: #b91c1c; }
  .pill-medium   { background: #fffbeb; color: #b45309; }
  .pill-info     { background: #f5f5f4; color: #525252; }

  /* ── Verification badge ────────────────────────────────────────── */
  .vbadge {
    display: inline-block; padding: 1px 7px; margin-left: 6px;
    background: #f0f7ff; color: #0f3a5f; border: 1px solid #cdd9e4;
    border-radius: 2px; font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.04em;
    font-family: ui-monospace, monospace;
  }

  /* ── Sections ──────────────────────────────────────────────────── */
  .sec { margin-bottom: 24px; }
  .sec p:first-of-type { margin-top: 4px; }
  .empty-note {
    background: #fafaf7; border: 1px solid #ece9df;
    padding: 12px 14px; color: #6b6b6b; font-size: 13.5px;
    border-radius: 2px;
  }
  .alert-banner {
    background: #fff7ed; border-left: 3px solid #b45309;
    padding: 10px 14px; margin: 8px 0 14px;
  }

  /* ── Tables (data tables) ──────────────────────────────────────── */
  table.dt {
    width: 100%; border-collapse: collapse; margin: 8px 0 12px;
    font-size: 13.5px; font-variant-numeric: tabular-nums;
  }
  table.dt th {
    text-align: left; font-family: Georgia, serif; font-size: 11.5px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: #4a4a4a; padding: 6px 8px;
    border-bottom: 1px solid #d4d4d4;
  }
  table.dt td {
    padding: 7px 8px; border-bottom: 1px solid #ececec;
    vertical-align: top;
  }
  table.dt-tight td, table.dt-tight th { padding: 5px 8px; font-size: 13px; }
  table.dt td.num, table.dt th.num { text-align: right;
    font-family: ui-monospace, monospace; }
  table.dt td.neg { color: #b91c1c; }
  table.dt td.pos { color: #047857; }
  table.dt td.model-name {
    font-family: Georgia, serif; font-weight: 600; color: #2a2a2a;
    width: 20%;
  }
  table.dt-grid4 td { border-bottom: 1px solid #f5f5f5; }

  /* ── Pick card (A-grade institutional treatment) ───────────────── */
  .pick {
    border: 1px solid #d4d4d4; border-left: 3px solid #065f46;
    padding: 18px 22px; margin: 14px 0 18px; background: #fefefe;
    border-radius: 1px;
  }
  .pick-head {
    border-bottom: 1px solid #ececec; padding-bottom: 10px; margin-bottom: 12px;
  }
  .pick-ticker { display: block; margin-bottom: 4px; }
  .pick-ticker .badge { margin-left: 10px; }
  .pick-meta { font-size: 12.5px; color: #6b6b6b; }

  /* Bull / Bear thesis cells */
  table.dt-thesis td.thesis-cell {
    width: 50%; padding: 12px 14px; vertical-align: top;
    border-bottom: none; border-right: 1px solid #ececec;
  }
  table.dt-thesis td.thesis-cell:last-child { border-right: none; }
  table.dt-thesis td.thesis-bull { background: #f6fcf8; }
  table.dt-thesis td.thesis-bear { background: #fafafa; }

  .watch {
    margin-top: 10px; padding-top: 10px;
    border-top: 1px dashed #e7e7e7;
    font-size: 13px; color: #4a4a4a;
  }
  .intel-note {
    background: #fafaf7; border-left: 3px solid #d4d4d4;
    padding: 8px 12px; margin: 8px 0 0; font-size: 13px;
    color: #4a4a4a; font-style: italic;
  }

  /* ── Brief picks (B-grade) ─────────────────────────────────────── */
  .brief-pick {
    border-bottom: 1px solid #ececec;
    padding: 12px 0;
  }
  .brief-pick:last-child { border-bottom: none; }
  .brief-head { margin-bottom: 6px; }
  .brief-head .badge { margin-left: 8px; }
  .grade-reasoning { color: #6b6b6b; font-size: 13px; }

  /* ── One-line picks (C-grade) ──────────────────────────────────── */
  ul.oneline { list-style: none; padding: 0; margin: 8px 0; }
  ul.oneline li {
    padding: 5px 0; border-bottom: 1px solid #f0f0f0; font-size: 13.5px;
  }
  ul.oneline li:last-child { border-bottom: none; }

  /* ── Portfolio card ────────────────────────────────────────────── */
  .port-card {
    border: 1px solid #d4d4d4; padding: 14px 18px; margin: 10px 0;
    background: #fefefe;
  }
  .port-name { margin-top: 0; }
  .rebal {
    margin-top: 10px; padding-top: 10px; border-top: 1px dashed #e7e7e7;
    font-size: 13px; color: #4a4a4a;
  }
  .stale-note {
    color: #b45309; font-size: 12.5px; margin-top: 8px;
  }

  /* ── Disclaimers ───────────────────────────────────────────────── */
  ul.disclaim {
    padding-left: 18px; color: #6b6b6b; font-size: 12.5px;
    line-height: 1.5;
  }
  ul.disclaim li { margin-bottom: 6px; }

  .src-line { font-size: 11.5px; color: #999; margin-top: 6px; }

  /* ── Footer ────────────────────────────────────────────────────── */
  .foot {
    border-top: 1px solid #d4d4d4; margin-top: 36px;
    padding-top: 14px; font-size: 11.5px; color: #999;
    font-family: ui-monospace, monospace; letter-spacing: 0.02em;
  }
  .foot .brand2 { letter-spacing: 0.16em; }

  /* ── Mobile (375px ≤ viewport ≤ 600px) ─────────────────────────── */
  @media only screen and (max-width: 600px) {
    .wrap { padding: 20px 16px 28px; border-left: none; border-right: none; }
    h1 { font-size: 22px; }
    .ticker-lg { font-size: 19px; }
    table.dt th, table.dt td { padding: 5px 4px; font-size: 12.5px; }
    table.dt-thesis td.thesis-cell {
      display: block; width: 100%; border-right: none;
      border-bottom: 1px solid #ececec;
    }
    .pick { padding: 14px 14px; }
    .verif { float: none; display: block; margin-top: 4px; }
  }

  /* ── Outlook 2016+ desktop specifics ───────────────────────────── */
  [data-ogsc] .badge-a, [data-ogsc] .badge-b, [data-ogsc] .badge-c { color: inherit; }
</style>
</head>
<body>

{% from "_macros.html.j2" import render_section, grade_badge %}

<div class="wrap">

  <header class="head">
    <div class="brand">Fortis Stock Intelligence</div>
    <h1>{{ report.header.title }}</h1>
    <div class="date">{{ report.header.date_label }}</div>
    <div class="grade-row">
      <span class="pill pill-info">A {{ report.header.a_count }}</span>
      <span class="pill pill-info">B {{ report.header.b_count }}</span>
      <span class="pill pill-info">C {{ report.header.c_count }}</span>
      {% if report.header.avg_verification_score is not none %}
        <span class="verif">avg verification {{ (report.header.avg_verification_score * 100)|round|int if report.header.avg_verification_score <= 1 else report.header.avg_verification_score|round|int }}%</span>
      {% endif %}
    </div>
  </header>

  {% block content %}
    {% for sec in report.sections %}
      {{ render_section(sec) }}
    {% endfor %}
  {% endblock %}

  <footer class="foot">
    <div><span class="brand2">FORTIS</span> · {{ report.meta.run_type|upper }} · {{ report.header.date_label }} · {{ report.meta.generation_time_seconds }}s · {{ report.meta.llm_calls_made }} LLM call{{ '' if report.meta.llm_calls_made == 1 else 's' }}</div>
    <div style="margin-top:4px">
      Composed by Fortis Report Composer (Step 7.1).
      Every claim traces to a row in the database — see content_structured.
    </div>
  </footer>

</div>
</body>
</html>
