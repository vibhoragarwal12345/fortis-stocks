# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python pipeline
/pipeline/venv/
/pipeline/__pycache__/
/pipeline/**/__pycache__/
/pipeline/**/*.pyc

# Local historical-analog store (multi-GB FAISS index + metadata)
/pipeline/data/historical_patterns.faiss
/pipeline/data/historical_patterns.parquet

# Cached SEC transcript JSON (30-day TTL; permanent copy lives in earnings_transcripts table)
/pipeline/data/transcripts/

# Generated performance / track-record reports
/pipeline/reports/

# Step 7.5 -- daily feedback diagnostics + retraining proposals. Uploaded
# as workflow artifacts in feedback_aggregator.yml; not source.
/pipeline/proposals/*.json
/pipeline/proposals/*.md
!/pipeline/proposals/.gitkeep

# Ad-hoc error logs
*.err
# Transient local scan log (was accidentally tracked)
scan_test.log

# Tier-4 audio transcription
/pipeline/vendor/                          # cloned + built whisper.cpp (and ffmpeg shim)
/pipeline/data/audio_cache/                # downloaded earnings-call audio (transcripts kept long-term, audio is not)
/pipeline/data/audio_discovery_cache.json  # audio-URL discovery result cache (one lookup per company per quarter)

# Commodities pipeline: generated smoke-test dumps + manual USGS imports stay local
/pipeline/commodities/data/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
